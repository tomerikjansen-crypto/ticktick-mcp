# TickTick API credentials
# These are required to authenticate with the TickTick API
# Get these from https://developer.ticktick.com
TICKTICK_CLIENT_ID=your_client_id_here
TICKTICK_CLIENT_SECRET=your_client_secret_here

# The access and refresh tokens are NOT stored here. The authentication flow
# ('uv run -m ticktick_mcp.cli auth' or 'ticktick-auth') writes them only to
# ~/.ticktick/tokens.json, which the server reads at startup.
# TICKTICK_ACCESS_TOKEN is only used as a fallback when that file does not exist.